<Window x:Class="MouseLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MouseLauncher"
        mc:Ignorable="d"
        Title="MouseClient Launcher"
        Height="620" Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">

    <Border Background="#0E1017"
            BorderBrush="#252A3B"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" /> <!-- Title Bar -->
                <RowDefinition Height="*" />  <!-- Main Content -->
                <RowDefinition Height="90" /> <!-- Bottom Action Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Top Title Bar -->
            <Border Grid.Row="0"
                    Background="#141722"
                    CornerRadius="14,14,0,0"
                    BorderBrush="#1F2332"
                    BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="MOUSE" FontWeight="Black" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="CLIENT" FontWeight="Black" FontSize="16" Foreground="#8B5CF6" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        
                        <!-- Version Badge -->
                        <Border Background="#232738" CornerRadius="6" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitleVersion" Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCtrlButton}" Content="—" Click="BtnMinimize_Click" ToolTip="Свернуть"/>
                        <Button Style="{StaticResource WindowCloseButton}" Content="✕" Click="BtnClose_Click" ToolTip="Закрыть"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Main Content Grid -->
            <Grid Grid.Row="1" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" /> <!-- Left: Banner & Updates -->
                    <ColumnDefinition Width="20" />    <!-- Spacer -->
                    <ColumnDefinition Width="*" />    <!-- Right: Settings -->
                </Grid.ColumnDefinitions>

                <!-- Left Column: Banner & News -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hero Banner -->
                    <Border Grid.Row="0" CornerRadius="12" Height="100" Margin="0,0,0,14" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C1D95" Offset="0"/>
                                <GradientStop Color="#1E1B4B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="18,14">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#10B981" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtServerStatus" Text="СЕРВЕР ОБНОВЛЕНИЙ: ОНЛАЙН" FontWeight="Bold" FontSize="11" Foreground="#34D399"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtBannerNotice" Text="MouseClient 1.0.0 — лучший приватный клиент!"
                                           FontWeight="ExtraBold" FontSize="17" Foreground="#FFFFFF" Margin="0,6,0,2"/>
                                <TextBlock Text="Синхронизация через GitHub CDN • Бесплатные автообновления"
                                           FontSize="12" Foreground="#C4B5FD"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Changelog Card -->
                    <Border Grid.Row="1" Background="#141620" BorderBrush="#232738" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚡ ЧТО НОВОГО В ОБНОВЛЕНИИ" FontWeight="Bold" FontSize="13" Foreground="#E5E7EB"/>
                                <TextBlock x:Name="TxtReleaseDate" Text="" FontSize="12" Foreground="#6B7280" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ItemsChangelog">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="• " Foreground="#8B5CF6" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#D1D5DB" FontSize="13" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Quick Links Bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="📁 Папка .minecraft" Click="BtnOpenMinecraft_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="🧩 Папка mods" Click="BtnOpenMods_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="🌐 GitHub" Click="BtnOpenGithub_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Right Column: Settings Card -->
                <Border Grid.Column="2" Background="#141620" BorderBrush="#232738" BorderThickness="1" CornerRadius="12" Padding="18,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="⚙ НАСТРОЙКИ ЗАПУСКА" FontWeight="Bold" FontSize="14" Foreground="#F3F4F6" Margin="0,0,0,16"/>

                            <!-- Nickname Field -->
                            <TextBlock Text="Никнейм игрока" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtNickname" Style="{StaticResource ModernTextBox}" Text="MouseUser" TextChanged="TxtNickname_TextChanged" Margin="0,0,0,16"/>

                            <!-- RAM Slider -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Оперативная память" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtRamValue" Text="4096 МБ (4.0 ГБ)" FontSize="12" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderRam" Style="{StaticResource ModernSlider}"
                                    Minimum="2048" Maximum="16384" SmallChange="512" LargeChange="1024"
                                    Value="4096" ValueChanged="SliderRam_ValueChanged" Margin="0,0,0,18"/>

                            <!-- Java Status Badge -->
                            <TextBlock Text="Среда исполнения Java" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Border Background="#10121A" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ElpJavaDot" Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtJavaStatus" Text="Проверка Java..." FontSize="12" Foreground="#D1D5DB" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Minecraft Path -->
                            <TextBlock Text="Директория .minecraft" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtGamePath" Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True" FontSize="11" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Обзор" Click="BtnBrowsePath_Click"/>
                            </Grid>

                            <!-- Checkbox: Auto-close -->
                            <CheckBox x:Name="ChkAutoClose" Content="Закрывать лаунчер при запуске"
                                      Foreground="#D1D5DB" FontSize="12" FontWeight="Medium"
                                      Checked="ChkAutoClose_Changed" Unchecked="ChkAutoClose_Changed"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 3. Bottom Action Bar -->
            <Border Grid.Row="2"
                    Background="#12141C"
                    BorderBrush="#1F2332"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="20,12">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status text & Progress Bar -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock x:Name="TxtStatus" Text="Готов к игре" FontSize="13" FontWeight="SemiBold" Foreground="#E5E7EB" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="PbDownload" Style="{StaticResource ModernProgressBar}" Value="0" Maximum="100" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Secondary Action: Install only -->
                    <Button x:Name="BtnInstallOnly" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                            Content="Установить в mods" Click="BtnInstallOnly_Click" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <!-- Primary Action: PLAY button -->
                    <Button x:Name="BtnPlay" Grid.Column="2" Style="{StaticResource PlayButtonStyle}"
                            Width="180" Height="48" Click="BtnPlay_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶ " FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="ИГРАТЬ" FontSize="16" FontWeight="Black"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
