<Window x:Class="MouseLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MouseLauncher"
        mc:Ignorable="d"
        Title="MouseClient Launcher"
        Height="614" Width="964"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Continuous Storyboards for Rotating Rings and Pulsing Logo -->
        <Storyboard x:Key="SpinClockwise" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LaunchOuterRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="SplashOuterRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.8" />
        </Storyboard>
        <Storyboard x:Key="SpinCounterClockwise" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LaunchInnerRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="360" To="0" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="SplashInnerRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="360" To="0" Duration="0:0:1.2" />
        </Storyboard>
        <Storyboard x:Key="PulseLogo" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LaunchLogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.06" Duration="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="LaunchLogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.06" Duration="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="SplashLogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.06" Duration="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="SplashLogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.06" Duration="0:0:0.8" />
        </Storyboard>
    </Window.Resources>

    <!-- Main Outer Window Border with Margin for Soft Rounded Glow -->
    <Border x:Name="MainOuterBorder"
            Margin="12"
            Background="#07080E"
            BorderBrush="#1B2238"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="4" Color="#00E5FF" Opacity="0.25"/>
        </Border.Effect>

        <!-- Clipped Inner Content Container -->
        <Border x:Name="MainContentRoot" CornerRadius="19" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" /> <!-- Top Minimalist Navigation Bar -->
                    <RowDefinition Height="*" />  <!-- Tab Content Area -->
                </Grid.RowDefinitions>

                <!-- 1. Minimalist Top Navigation Bar -->
                <Border Grid.Row="0"
                        Background="#0B0D17"
                        BorderBrush="#161B2E"
                        BorderThickness="0,0,0,1"
                        CornerRadius="19,19,0,0"
                        MouseDown="TitleBar_MouseDown">
                    <Grid Margin="20,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand Logo + Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/logo.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="MOUSE" FontWeight="Black" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="CLIENT" FontWeight="Black" FontSize="16" Foreground="#00E5FF" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <Border Background="#131728" CornerRadius="8" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center" BorderBrush="#202A46" BorderThickness="1">
                                <TextBlock x:Name="TxtTitleVersion" Text="v1.0.0 Релиз" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>

                        <!-- Center: Clean Minimalist Tabs -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <RadioButton x:Name="TabHome" Style="{StaticResource NavTabStyle}" Content="Главная" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabSettings" Style="{StaticResource NavTabStyle}" Content="Настройки" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabChangelog" Style="{StaticResource NavTabStyle}" Content="Обновления" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabAbout" Style="{StaticResource NavTabStyle}" Content="О клиенте" Checked="Tab_Checked"/>
                        </StackPanel>

                        <!-- Right: Window Control Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource WindowCtrlButton}" Content="—" Click="BtnMinimize_Click" ToolTip="Свернуть"/>
                            <Button Style="{StaticResource WindowCloseButton}" Content="✕" Click="BtnClose_Click" ToolTip="Закрыть"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Main Content Area (Tab Views) -->
                <Grid Grid.Row="1">

                    <!-- TAB 1: HOME (Cinematic Shader Background + Hero Play) -->
                    <Grid x:Name="PanelHome" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                        <!-- Shader Minecraft Wallpaper with Cinematic Vignette -->
                        <Image Source="/Assets/shaders_bg.jpg" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Dark Gradient Overlays for Readability and Depth -->
                        <Grid>
                            <!-- Bottom Gradient -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0007080E" Offset="0.35"/>
                                        <GradientStop Color="#CC07080E" Offset="0.75"/>
                                        <GradientStop Color="#F207080E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Left Vignette Gradient -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#9907080E" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Bottom Hero Content -->
                        <Grid VerticalAlignment="Bottom" Margin="32,0,32,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Client Info & Player Quick Chips -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <!-- Glow Tag -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="8" Height="8" Fill="#00E5FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#00E5FF" Opacity="0.9"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="FABRIC 1.21.11 • БЕСПЛАТНЫЙ РЕЛИЗ" FontSize="11" FontWeight="Black" Foreground="#00E5FF"/>
                                </StackPanel>

                                <!-- Big Futuristic Title -->
                                <TextBlock Text="MOUSE CLIENT" FontSize="36" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,4">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.8"/>
                                    </TextBlock.Effect>
                                </TextBlock>

                                <TextBlock Text="Самая лучшая модификация для доминирования"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,16"/>

                                <!-- Player & RAM Chips with Modern Rounding -->
                                <StackPanel Orientation="Horizontal">
                                    <!-- Nick Chip -->
                                    <Border Background="#D90E111C" BorderBrush="#252F4A" BorderThickness="1" CornerRadius="12" Padding="14,7" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👤 " FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtHomeNickname" Text="MouseUser" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- RAM Chip -->
                                    <Border Background="#D90E111C" BorderBrush="#252F4A" BorderThickness="1" CornerRadius="12" Padding="14,7" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ " FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtHomeRam" Text="4096 МБ" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Status Chip -->
                                    <Border Background="#D90E111C" BorderBrush="#252F4A" BorderThickness="1" CornerRadius="12" Padding="14,7">
                                        <TextBlock x:Name="TxtHomeStatus" Text="Готов к игре" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Minimalist Neon Play Button -->
                            <Button x:Name="BtnPlay" Grid.Column="1" Style="{StaticResource PlayButtonStyle}"
                                    Width="180" Height="48" Click="BtnPlay_Click" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="13" FontWeight="Black" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ИГРАТЬ" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                <!-- TAB 2: SETTINGS (Minimalist Dark Glass) -->
                <Grid x:Name="PanelSettings" Visibility="Collapsed" Margin="32,24" RenderTransformOrigin="0.5,0.5">
                    <Border Background="#E60D0F1A" BorderBrush="#1C2338" BorderThickness="1" CornerRadius="20" Padding="28,24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                                <TextBlock Text="НАСТРОЙКИ ЗАПУСКА" FontWeight="Black" FontSize="18" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                <TextBlock Text="Настройте никнейм и выделение ресурсов для максимальной плавности" FontSize="13" Foreground="#64748B" Margin="0,0,0,24"/>

                                <!-- Nickname -->
                                <TextBlock Text="Никнейм игрока" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                <TextBox x:Name="TxtNickname" Style="{StaticResource ModernTextBox}" Text="MouseUser" TextChanged="TxtNickname_TextChanged" Margin="0,0,0,22"/>

                                <!-- RAM Slider -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Выделение оперативной памяти" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtRamValue" Text="4096 МБ (4.0 ГБ)" FontSize="12" FontWeight="Black" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderRam" Style="{StaticResource ModernSlider}"
                                        Minimum="2048" Maximum="16384" SmallChange="512" LargeChange="1024"
                                        Value="4096" ValueChanged="SliderRam_ValueChanged" Margin="0,0,0,24"/>

                                <!-- Minecraft Path -->
                                <TextBlock Text="Директория игры (.minecraft)" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtGamePath" Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True" FontSize="11" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource WindowCtrlButton}" Content="Обзор" Width="Auto" Padding="16,0" Height="38" Background="#161B2E" Foreground="#FFFFFF" Click="BtnBrowsePath_Click"/>
                                </Grid>

                                <!-- Java Status -->
                                <Border Background="#090B12" BorderBrush="#1C2338" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ElpJavaDot" Width="9" Height="9" Fill="#00E5FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtJavaStatus" Text="Java 21 найдена" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Auto-close Toggle -->
                                <CheckBox x:Name="ChkAutoClose" Content="Закрывать лаунчер при запуске игры"
                                          Foreground="#94A3B8" FontSize="13" FontWeight="Medium"
                                          Checked="ChkAutoClose_Changed" Unchecked="ChkAutoClose_Changed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- TAB 3: CHANGELOG (Minimalist Cards) -->
                <Grid x:Name="PanelChangelog" Visibility="Collapsed" Margin="32,24" RenderTransformOrigin="0.5,0.5">
                    <Border Background="#E60D0F1A" BorderBrush="#1C2338" BorderThickness="1" CornerRadius="20" Padding="28,24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="СПИСОК ОБНОВЛЕНИЙ" FontWeight="Black" FontSize="18" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Актуальные изменения и история релизов MouseClient" FontSize="13" Foreground="#64748B" Margin="0,0,0,14"/>

                                <!-- Release Highlights Card -->
                                <Border Background="#12182E" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="14" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#7C3AED" CornerRadius="8" Padding="10,4" Margin="0,0,12,0">
                                                <TextBlock Text="РЕЛИЗ" FontSize="11" FontWeight="Black" Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock Text="MouseClient v1.0.0" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Официальная версия • Бесплатно" FontSize="12" FontWeight="SemiBold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ItemsChangelog">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#090B12" BorderBrush="#1A2033" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="◆ " Foreground="#00E5FF" FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 4: ABOUT & SHORTCUTS -->
                <Grid x:Name="PanelAbout" Visibility="Collapsed" Margin="32,24" RenderTransformOrigin="0.5,0.5">
                    <Border Background="#E60D0F1A" BorderBrush="#1C2338" BorderThickness="1" CornerRadius="20" Padding="28,24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                            <Image Source="/Assets/logo.png" Width="64" Height="64" Margin="0,0,0,14" HorizontalAlignment="Center"/>
                            <TextBlock Text="MOUSE CLIENT" FontSize="22" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Бесплатный чит-клиент нового поколения для Minecraft 1.21.11 Fabric" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="📁 Папка mods" Style="{StaticResource WindowCtrlButton}" Width="Auto" Padding="16,8" Height="38"
                                        Background="#15192B" Foreground="#FFFFFF" Click="BtnOpenMods_Click" Margin="0,0,12,0"/>
                                <Button Content="📁 Папка .minecraft" Style="{StaticResource WindowCtrlButton}" Width="Auto" Padding="16,8" Height="38"
                                        Background="#15192B" Foreground="#FFFFFF" Click="BtnOpenMinecraft_Click" Margin="0,0,12,0"/>
                                <Button Content="🌐 GitHub" Style="{StaticResource WindowCtrlButton}" Width="Auto" Padding="16,8" Height="38"
                                        Background="#15192B" Foreground="#00E5FF" Click="BtnOpenGithub_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. ULTRA-BEAUTIFUL STARTUP SPLASH SCREEN (Shown on Launch for ~1.5s) -->
            <Border x:Name="StartupSplashOverlay"
                    Grid.RowSpan="2"
                    Background="#FA07080E"
                    CornerRadius="20"
                    Visibility="Visible">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Dual Concentric Neon Rings + Pulsing Logo -->
                        <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <!-- Outer Neon Cyan Ring -->
                            <Ellipse Width="116" Height="116" StrokeThickness="3" StrokeDashArray="4 2">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00E5FF" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="0.7"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="18" Color="#00E5FF" Opacity="0.8"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SplashOuterRing" CenterX="58" CenterY="58"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Inner Neon Violet Ring -->
                            <Ellipse Width="86" Height="86" StrokeThickness="3" StrokeDashArray="3 1.5">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A855F7" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="0.7"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="16" Color="#A855F7" Opacity="0.8"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SplashInnerRing" CenterX="43" CenterY="43"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Center Pulsing Logo -->
                            <Image Source="/Assets/logo.png" Width="44" Height="44"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="22" Color="#00E5FF" Opacity="0.85"/>
                                </Image.Effect>
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="SplashLogoScale" CenterX="22" CenterY="22"/>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>

                        <TextBlock Text="MOUSE CLIENT" FontSize="19" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#A855F7" Offset="0"/>
                                    <GradientStop Color="#00E5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <TextBlock x:Name="TxtSplashStatus" Text="Инициализация лаунчера..."
                                   FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <ProgressBar x:Name="PbSplash" Style="{StaticResource ModernProgressBar}"
                                     Width="220" Height="4" Value="60" Maximum="100"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. ULTRA-BEAUTIFUL GAME LAUNCH OVERLAY (Shown when Clicking 'PLAY') -->
            <Border x:Name="GameLaunchOverlay"
                    Grid.RowSpan="2"
                    Background="#F207080E"
                    CornerRadius="20"
                    Opacity="0"
                    Visibility="Collapsed">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Dual Concentric Neon Rings + Pulsing Logo -->
                        <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <!-- Outer Neon Cyan Ring -->
                            <Ellipse Width="116" Height="116" StrokeThickness="3" StrokeDashArray="4 2">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00E5FF" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="0.7"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="20" Color="#00E5FF" Opacity="0.85"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="LaunchOuterRing" CenterX="58" CenterY="58"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Inner Neon Violet Ring -->
                            <Ellipse Width="86" Height="86" StrokeThickness="3" StrokeDashArray="3 1.5">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A855F7" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="0.7"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="18" Color="#A855F7" Opacity="0.85"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="LaunchInnerRing" CenterX="43" CenterY="43"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Center Pulsing Logo -->
                            <Image Source="/Assets/logo.png" Width="44" Height="44"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="22" Color="#00E5FF" Opacity="0.85"/>
                                </Image.Effect>
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="LaunchLogoScale" CenterX="22" CenterY="22"/>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>

                        <TextBlock Text="ЗАПУСК MOUSE CLIENT" FontSize="19" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#A855F7" Offset="0"/>
                                    <GradientStop Color="#00E5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <TextBlock x:Name="TxtLaunchStatus" Text="Подготовка файлов..."
                                   FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <ProgressBar x:Name="PbLaunch" Style="{StaticResource ModernProgressBar}"
                                     Width="280" Height="6" Value="20" Maximum="100"/>

